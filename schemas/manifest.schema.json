{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mdv:schema:0.1:manifest",
  "title": "MDV 0.1 manifest",
  "type": "object",
  "required": [
    "format",
    "formatVersion",
    "documentId",
    "generation",
    "markdownProfile"
  ],
  "properties": {
    "format": {
      "const": "mdv"
    },
    "formatVersion": {
      "const": "0.1"
    },
    "documentId": {
      "type": "string",
      "pattern": "^d_[0-9a-f]{32}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "markdownProfile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    }
  },
  "additionalProperties": true
}

