{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mdv:schema:0.1:document-version",
  "title": "MDV 0.1 Document Version metadata",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "parent",
    "createdAt",
    "actor",
    "summary",
    "contentSha256",
    "contentBytes",
    "referenceVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/versionId"
    },
    "parent": {
      "oneOf": [
        {
          "$ref": "#/$defs/versionId"
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "actor": {
      "$ref": "#/$defs/actor"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "contentSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "contentBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "referenceVersion": {
      "oneOf": [
        {
          "$ref": "#/$defs/versionId"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": true,
  "$defs": {
    "versionId": {
      "type": "string",
      "pattern": "^v_[0-9a-f]{32}$"
    },
    "actor": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "human",
            "agent"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "additionalProperties": true
    }
  }
}

