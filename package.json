{
  "name": "@mdv/core",
  "version": "0.0.0-development",
  "description": "Reference TypeScript library for Markdown Document with Versions (.mdv)",
  "type": "module",
  "files": [
    "dist",
    "schemas",
    "spec"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "fixtures": "node scripts/build-fixtures.mjs",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/yauzl": "^3.4.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "yauzl": "^3.4.0"
  }
}
