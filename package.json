{
  "name": "@owariband/mdv",
  "version": "0.0.0-development",
  "description": "Reference TypeScript library for Markdown Document with Versions (.mdv)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owariband/mdv.git"
  },
  "bugs": {
    "url": "https://github.com/owariband/mdv/issues"
  },
  "homepage": "https://github.com/owariband/mdv#readme",
  "keywords": [
    "markdown",
    "versioning",
    "document-format"
  ],
  "type": "module",
  "files": [
    "dist",
    "docs/**/*.md",
    "docs/assets/mdv-icon.svg",
    "schemas",
    "spec"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "fixtures": "node scripts/build-fixtures.mjs",
    "fixtures:check": "node scripts/build-fixtures.mjs --check",
    "test:package": "node scripts/test-package.mjs",
    "test:fuzz": "npm run build && node --test test/fuzz.test.mjs",
    "bench": "npm run build && node bench/history.mjs",
    "check": "npm run typecheck && npm run fixtures:check && npm test && npm run check:release",
    "check:release": "node scripts/check-release.mjs",
    "prepublishOnly": "npm run check:release -- --release && npm run check && npm run test:package",
    "prepare": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "3.3.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "yauzl": "^3.4.0",
    "yazl": "3.3.1"
  }
}
